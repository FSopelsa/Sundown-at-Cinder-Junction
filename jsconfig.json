{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "tests/**/*.js"]
}
